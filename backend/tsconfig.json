{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "moduleResolution": "node",
    // TS 5.9+ renamed this mode to "node10" and started flagging plain
    // "node" as deprecated (TS5107), escalating to a hard error on some
    // TS versions (the repo pins ^5.3.3, but a newer TS resolved locally —
    // e.g. via a global install or a different lockfile — hits this).
    // This project is CommonJS/Node (`module: "commonjs"`, run via
    // ts-node-dev / `node dist/index.js`), so "node10" resolution is still
    // the correct semantics here, not a bug to migrate away from; this
    // just silences the deprecation warning as TS's own error message
    // recommends, without changing resolution behavior.
    "ignoreDeprecations": "6.0",
    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "declaration": false,
    // NOTE: `strict` (and specifically `strictNullChecks`) is intentionally
    // off, not on. This repo was written and run exclusively via
    // `ts-node-dev` with no `tsconfig.json` in the project at all, so `tsc`
    // never actually typechecked it before. Turning full strict mode on
    // surfaces pre-existing inference gaps — e.g. `let coupon = null;` in
    // src/routes/orders.ts gets inferred as type `null` rather than
    // `Coupon | null` — that are real, but fixing them means editing
    // application source, which was explicitly out of scope here. Loosening
    // this flag keeps the build green without touching src/. If you want
    // full strict-mode safety later, flip this to `true` and work through
    // the resulting errors (they're narrow and mechanical: add explicit
    // type annotations at `let x = null` declarations).
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitAny": false,
    "strictPropertyInitialization": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "prisma/seed.ts", "scripts"]
}
