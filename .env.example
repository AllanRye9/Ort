# ─── Database ─────────────────────────────────────────────────────────────────
# Railway provides DATABASE_URL automatically when you add a PostgreSQL service.
# Local docker-compose: use the connection below.
DATABASE_URL=postgresql://postgres:postgres@db:5432/ort_marketplace

# ─── App security ─────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE-THIS-TO-A-LONG-RANDOM-STRING-IN-PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Domain & CORS ────────────────────────────────────────────────────────────
# Leave BLANK for open CORS (allows any origin — safe because credentials=false).
# Set to comma-separated origins to restrict:
#   CORS_ORIGINS=https://piitrade.com,https://www.piitrade.com
# When blank, the app auto-allows all origins (needed during Railway preview).
CORS_ORIGINS=

# ─── App base URL (used by upload.py to construct public file URLs) ───────────
APP_BASE_URL=https://piitrade.com

# ─── App download URLs ────────────────────────────────────────────────────────
# Set these once your APK / IPA files are hosted on a CDN or file server.
# The landing page shows a friendly "coming soon" dialog if these are blank.
APK_DOWNLOAD_URL=https://your-cdn.example.com/ort-latest.apk
IPA_DOWNLOAD_URL=https://your-cdn.example.com/ort-latest.ipa
TESTFLIGHT_URL=https://testflight.apple.com/join/XXXXXXXX

# ─── Currency / geolocation ───────────────────────────────────────────────────
DEFAULT_CURRENCY=UGX

# ─── AWS S3 (optional – for image/file uploads) ───────────────────────────────
# Leave blank to use local disk storage (static/listings/).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1

# ─── OpenAI (optional – for AI assistant features) ────────────────────────────
OPENAI_API_KEY=

# ─── Admin seed account ───────────────────────────────────────────────────────
ADMIN_EMAIL=admin@piitrade.com
ADMIN_PASSWORD=changeme-before-deploy

# ─── Port (Railway sets this automatically – do not set manually on Railway) ──
# PORT=8080
