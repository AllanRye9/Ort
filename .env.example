# ============================================================
# Docker Compose environment variables
# Copy this file to .env and fill in the values before running
# docker-compose up -d
# ============================================================

# --- PostgreSQL -------------------------------------------------
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=marketplace_secret
POSTGRES_DB=marketplace_db

# --- JWT (REQUIRED – change these to long random strings) -------
JWT_SECRET=change-this-jwt-secret-in-production
JWT_REFRESH_SECRET=change-this-refresh-secret-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- CORS -------------------------------------------------------
# Comma-separated list of allowed frontend origins.
# In production, set this to your deployed frontend URL(s), e.g.:
#   CORS_ORIGIN=https://client-production-9fdc.up.railway.app,http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# --- Frontend API URL -------------------------------------------
# Browser-accessible URL of the backend API.
# For local Docker: keep as http://localhost:5000 (port 5000 is
# exposed to the host by docker-compose).
# For remote deployment: set to the public backend URL, e.g.
# https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:5000
# Public URL of the backend – used by the backend itself to construct
# image proxy URLs returned to the client (e.g. /api/images/<file>).
# Must match NEXT_PUBLIC_API_URL in production.
API_BASE_URL=http://localhost:5000

# --- AWS S3 / S3-compatible storage (optional) ------------------
# When all three core variables are set the backend uploads images to the
# configured bucket and serves them through the /api/images proxy route.
# The bucket can be kept private – no public access is required.
#
# Supports Railway native buckets as well as any S3-compatible service:
#   • Railway native bucket (preferred)
#   • AWS S3
#   • MinIO (self-hosted)
#   • Any other S3-compatible provider
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
BUCKET=
# Optional: custom endpoint URL for S3-compatible providers.
# Leave empty for standard AWS S3.  Examples:
#   Railway:  https://<region>.railway-bucket.com
#   MinIO:    http://localhost:9000
ENDPOINT=

# --- Email provider (optional) -----------------------------------
# Resend is used first when configured; SMTP is fallback.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Rate limiting ----------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
